.DS_Store
.venv/
.claude/
__pycache__/
*.pyc

data_cache/
results/*
data/live_platform.db

# local token config (use config.example.py as template)
config.py

# Three-layer results layout:
# - results/backtests/: heavy strategy run artifacts, ignored by default
# - results/research/: lightweight tracked research outputs
# - results/live/: local live-platform exports, ignored except the directory marker
!results/backtests/
results/backtests/*
!results/backtests/a_share/
results/backtests/a_share/*
!results/backtests/a_share/.gitkeep
!results/backtests/hkconnect/
results/backtests/hkconnect/*
!results/backtests/hkconnect/.gitkeep
!results/research/
!results/research/**
!results/live/
results/live/*
!results/live/.gitkeep
